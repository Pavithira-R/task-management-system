generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────
enum Status {
  BACKLOG
  TODO
  IN_PROGRESS
  REVIEW
  COMPLETED
  BLOCKED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum ProjectRole {
  PROJECT_MANAGER
  COLLABORATOR
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
  COMPLETED
}

enum NotificationType {
  TASK_ASSIGNED
  STATUS_CHANGED
  DEADLINE_ALERT
  COMMENT_ADDED
  ADMIN_UPDATE
}

enum ActivityType {
  CREATED
  UPDATED
  ASSIGNED
  COMMENTED
  COMPLETED
  DELETED
}

enum Role {
  ADMIN
  PROJECT_MANAGER
  COLLABORATOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  id               Int        @id @default(autoincrement())
  name             String
  email            String     @unique
  passwordHash     String
  role             Role       @default(COLLABORATOR)
  status           UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(true)
  isEmailVerified  Boolean    @default(false)
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt @default(now())

  ownedProjects   Project[]        @relation("OwnedProjects")
  projectMembers  ProjectMember[]
  taskAssignments TaskAssignment[]
  createdTasks    Task[]           @relation("CreatedTasks")
  comments        Comment[]
  notifications   Notification[]
  attachments     Attachment[]
  taskActivities  TaskActivity[]
  sentMessages    Message[]        @relation("SentMessages")

  @@map("users")
}

// ─── PROJECTS ────────────────────────────────────────
model Project {
  id          Int           @id @default(autoincrement())
  name        String
  description String?
  ownerId     Int
  owner       User          @relation("OwnedProjects", fields: [ownerId], references: [id])
  status      ProjectStatus @default(ACTIVE)
  startDate   DateTime?
  endDate     DateTime?
  isDeleted   Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tasks      Task[]
  members    ProjectMember[]
  messages   Message[]
  attachments Attachment[]
  labels     Label[]

  @@index([ownerId])
  @@map("projects")
}

// ─── PROJECT MEMBERS ─────────────────────────────────
model ProjectMember {
  id        Int         @id @default(autoincrement())
  projectId Int
  project   Project     @relation(fields: [projectId], references: [id])
  userId    Int
  user      User        @relation(fields: [userId], references: [id])
  role      ProjectRole @default(COLLABORATOR)
  joinedAt  DateTime    @default(now())

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

// ─── TASKS ───────────────────────────────────────────
model Task {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  projectId   Int
  project     Project   @relation(fields: [projectId], references: [id])
  creatorId   Int
  creator     User      @relation("CreatedTasks", fields: [creatorId], references: [id])
  status      Status    @default(TODO)
  priority    Priority  @default(MEDIUM)
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  assignees      TaskAssignment[]
  comments       Comment[]
  attachments    Attachment[]
  taskActivities TaskActivity[]
  subtasks       Subtask[]
  labels         TaskLabel[]

  @@index([projectId])
  @@index([creatorId])
  @@map("tasks")
}

// ─── TASK ASSIGNMENTS ────────────────────────────────
model TaskAssignment {
  id         Int      @id @default(autoincrement())
  taskId     Int
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  assignedAt DateTime @default(now())

  @@unique([taskId, userId])
  @@index([userId])
  @@map("task_assignments")
}

// ─── LABELS (PROJECT-SCOPED TAGS) ────────────────────
model Label {
  id        Int         @id @default(autoincrement())
  name      String
  color     String      @default("#118B95")
  projectId Int
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  tasks TaskLabel[]

  @@unique([projectId, name])
  @@map("labels")
}

model TaskLabel {
  taskId  Int
  task    Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  labelId Int
  label   Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@index([labelId])
  @@map("task_labels")
}

// ─── SUBTASKS (CHECKLIST) ────────────────────────────
model Subtask {
  id          Int       @id @default(autoincrement())
  title       String
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  position    Int       @default(0)
  taskId      Int
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([taskId])
  @@map("subtasks")
}

// ─── COMMENTS ────────────────────────────────────────
model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  taskId    Int
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
  @@index([userId])
  @@map("comments")
}

// ─── ATTACHMENTS ─────────────────────────────────────
model Attachment {
  id         Int      @id @default(autoincrement())
  filename   String
  fileUrl    String
  storageKey String?
  fileSize   Int      @default(0)
  mimeType   String?
  taskId     Int?
  task       Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  projectId  Int?
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt @default(now())

  @@index([taskId])
  @@index([projectId])
  @@index([userId])
  @@map("attachments")
}

// ─── NOTIFICATIONS ───────────────────────────────────
model Notification {
  id        Int              @id @default(autoincrement())
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  userId    Int
  user      User             @relation(fields: [userId], references: [id])
  taskId    Int?
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([taskId])
  @@map("notifications")
}

// ─── TASK ACTIVITY LOG ───────────────────────────────
model TaskActivity {
  id          Int          @id @default(autoincrement())
  taskId      Int
  task        Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId      Int
  user        User         @relation(fields: [userId], references: [id])
  action      ActivityType
  description String?
  createdAt   DateTime     @default(now())

  @@index([taskId])
  @@index([userId])
  @@map("task_activities")
}

// ─── ACCESS REQUESTS & SYSTEM LOGS ────────────────────
enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model RegistrationRequest {
  id        Int           @id @default(autoincrement())
  name      String
  email     String        @unique
  status    RequestStatus @default(PENDING)
  createdAt DateTime      @default(now())

  @@map("registration_requests")
}

model SystemLog {
  id        Int      @id @default(autoincrement())
  action    String
  message   String
  createdAt DateTime @default(now())

  @@map("system_logs")
}

// ─── MESSAGES ─────────────────────────────────────────
model Message {
  id        Int      @id @default(autoincrement())
  content   String
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id])
  senderId  Int
  sender    User     @relation("SentMessages", fields: [senderId], references: [id])
  createdAt DateTime @default(now())

  @@map("messages")
}
